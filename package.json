{
  "name": "free-llm-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "free-llm-router —— 多供应商账号池 + 任务自动化 + OpenAI 兼容 API 聚合（Cloudflare Workers）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:check": "wrangler deploy --dry-run --outdir=.build",
    "build:node": "node scripts/build-node.mjs",
    "build:web": "node scripts/embed-web.mjs",
    "start": "node dist/server.mjs",
    "start:node": "node dist/server.mjs",
    "test": "bash scripts/test.sh",
    "local": "node start-local.mjs",
    "build:local": "node scripts/build-local-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
